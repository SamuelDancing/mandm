<ol class='items-list'>
  <li class='item flexrow items-header'>
    <div class='item-name'>{{localize 'Name'}}</div>
    <div class="item-tier">Tier/School</div>
    <div class="item-components">Components</div>
    <div class="item-target">Targets</div>
    <div class="item-prep">Prepared</div>
    <div class='item-controls'>
      <a
        class='item-control item-create'
        title='{{localize "DOCUMENT.Create" type='Item'}}'
        data-type='spell'
      >
        <i class='fas fa-plus'></i>
        {{localize 'DOCUMENT.New' type='Spell'}}
      </a>
    </div>
  </li>
  {{#each spells as |item id|}}
    <li class='item flexrow' data-item-id='{{item._id}}'>
      <div class='item-name'>
        <div class='item-image'>
          <a class='rollable' data-roll-type='item'>
            <img
              src='{{item.img}}'
              title='{{item.name}}'
              width='24'
              height='24'
            />
          </a>
        </div>
        <a class='rollable' data-roll-type='item'>
          <h4 style="text-wrap: wrap;">{{item.name}}</h4>
        </a>
      </div>
      <div class="item-tier">{{item.system.school}}, {{item.system.tier}}</div>
      <div class="item-components">{{ifThen item.system.components.v "V " ""}}{{ifThen item.system.components.s "S " ""}}{{#if item.system.components.m}}M ({{item.system.components.material}}) {{/if}}{{ifThen item.system.components.f "F " ""}}{{ifThen item.system.components.c "C " ""}}</div>
      <div class="item-target">{{item.system.target}}</div>
      <div class="item-prep">{{item.system.prepared}}</div>
      <div class='item-controls'>
        <a
          class='item-control item-edit'
          title='{{localize "DOCUMENT.Update" type='Item'}}'
        >
          <i class='fas fa-edit'></i>
        </a>
        <a
          class='item-control item-delete'
          title='{{localize "DOCUMENT.Delete" type='Item'}}'
        >
          <i class='fas fa-trash'></i>
        </a>
      </div>
    </li>
  {{/each}}
</ol>