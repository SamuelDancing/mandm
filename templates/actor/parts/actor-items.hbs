<ol class='items-list'>
  <li class='item flexrow items-header'>
    <div class='item-name'>{{localize 'Name'}}</div>
    <div class="item-count">Count</div>
    <div class="item-count">Weight</div>
    <div class="item-count">Value</div>
    <div class='item-controls'>
      <a
        class='item-control item-create'
        title='{{localize "DOCUMENT.Create" type='Item'}}'
        data-type='item'
      >
        <i class='fas fa-plus'></i>
        {{localize 'DOCUMENT.New' type='Item'}}
      </a>
    </div>
  </li>
  {{#each gear as |item id|}}
    <li class='item flexrow' data-item-id='{{item._id}}'>
      <a class='item-control item-edit' title='View/Edit' style="background: #DDD;
    padding: 1px 4px;
    border: 1px solid var(--color-border-dark-tertiary);
    border-radius: 2px;
    white-space: nowrap;">
      <div class='item-name'>
        <div class='item-image'>
            <img
              src='{{item.img}}'
              title='{{item.name}}'
              width='24'
              height='24'
            />
        </div>
        <h4 style="text-wrap: wrap;">{{item.name}}</h4>
      </div>
          </a>
      <div class="item-count align-center"><p>{{item.system.quantity}}</p></div>
      <div class="item-weight align-center"><p>{{item.system.weight}} ({{item.system.weight_sum}}) lbs</p></div>
      <div class="item-value align-center"><p>{{item.system.value}} ({{item.system.value_sum}}) GP</p></div>
      <div class='item-controls'>
        <!--
        <a
          class='item-control item-edit'
          title='{{localize "DOCUMENT.Update" type='Item'}}'
        >
          <i class='fas fa-edit'></i>
        </a>
        -->
        <a
          class='item-control item-delete'
          title='{{localize "DOCUMENT.Delete" type='Item'}}'
        >
          <i class='fas fa-trash'></i>
        </a>
      </div>
    </li>
  {{/each}}
</ol>