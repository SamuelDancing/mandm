<ol class='items-list'>
  <li class='item flexrow items-header'>
    <div class='item-name'>{{localize 'Name'}}</div>
    <div class="item-actions">Act</div>
    <div class='item-controls'>
    </div>
  </li>
  {{#each actions as |item id|}}
    <li class='item flexrow' data-item-id='{{item._id}}'>
          <a class='item-control item-edit' title='View/Edit' style="background: #DDD;
    padding: 1px 4px;
    border: 1px solid var(--color-border-dark-tertiary);
    border-radius: 2px;
    white-space: nowrap;">
      <div class='item-name'>
        <div class='item-image'>
            <img
              src='{{item.img}}'
              title='{{item.name}}'
              width='24'
              height='24'
            />
        </div>
        <h4 style="text-wrap: wrap;">{{item.name}}</h4>
      </div>
          </a>
      <div class="item-actions align-center"><a class='rollable' data-roll-type='item'>
          Actions: {{item.system.actions}}<br>{{item.system.resource_cost}}
        </a></div>
      <div class='item-controls alight-right'>
<!--        <a
          class='item-control item-edit'
          title='{{localize "DOCUMENT.Update" type='Item'}}'
        >
          <i class='fas fa-edit'></i>
        </a>
        -->
        <a
          class='item-control item-delete'
          title='{{localize "DOCUMENT.Delete" type='feat'}}'
        >
          <i class='fas fa-trash'></i>
        </a>
      </div>
    </li>
  {{/each}}
</ol>