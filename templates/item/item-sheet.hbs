{{! This template is a fallback for when items don't have more specific templates. }}
{{! Generally, you'll want to make more specific templates when possible. }}
<form class='{{cssClass}}' autocomplete='off'>
  <header class='sheet-header'>
    <img
      class='profile-img'
      src='{{item.img}}'
      data-edit='img'
      title='{{item.name}}'
    />
    <div class='header-fields'>
      <h1 class='charname'><input
          name='name'
          type='text'
          value='{{item.name}}'
          placeholder='Name'
        /></h1>
    </div>
  </header>

  {{! Sheet Tab Navigation }}
  <nav class='sheet-tabs tabs' data-group='primary'>
    <a class='item' data-tab='description'>Description</a>
    <a class='item' data-tab='action'>Action Config</a>
    <a class='item' data-tab='effect'>Effect Config</a>
  </nav>

  {{! Sheet Body }}
  <section class='sheet-body'>

    {{! Description Tab }}
    <div class='tab' data-group='primary' data-tab='description'>
      <div class="grid grid-2col" style="min-height: 100%; height:fit-content">
      <ul style="list-style: none;">
        <li>Traits: <a class="new-trait"><i class='fas fa-plus'></i>New Trait</a></li>{{#each system.trait as |i key|}}<li><input style="width:90%" type="text" name="system.trait.{{key}}" value="{{i}}"><a class="remove-trait" data-key="{{key}}"><i class='fas fa-trash'></i></a></li>{{/each}}
        <li>Quantity: {{numberInput system.quantity class="numberInput" name="system.quantity"}}</li>
        <li>Weight (lbs): {{numberInput system.weight class="numberInput" name="system.weight"}}</li>
        <li>Cost (GP): {{numberInput system.value class="numberInput" name="system.value"}}</li>
        <li>Complexity: {{numberInput system.complexity class="numberInput" name="system.complexity"}}</li>
        <li>Material: <input type="text" name="system.material" value="{{system.material}}"></li>
      </ul>
      <div class="editorboxformat">
      {{! Editors must receive enriched text data from getData to properly handle rolls }}
      {{editor
        enrichedDescription
        target='system.description'
        engine='prosemirror'
        button=true
        editable=editable
      }}</div>
    </div></div>
      {{! As you add new fields, add them in here! }}
    <div class="tab action" data-group="primary" data-tab="action">
      {{> 'systems/mandm/templates/item/parts/item-action-config.hbs'}}
    </div>
    <div class='tab' data-group='primary' data-tab='effect'>
      {{> "systems/mandm/templates/item/parts/item-effects.hbs"}}
    </div>
  </section>
</form>