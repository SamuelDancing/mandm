{{! This template is a fallback for when items don't have more specific templates. }}
{{! Generally, you'll want to make more specific templates when possible. }}
<form class='{{cssClass}}' autocomplete='off'>
  <header class='sheet-header'>
    <img
      class='profile-img'
      src='{{item.img}}'
      data-edit='img'
      title='{{item.name}}'
    />
    <div class='header-fields'>
      <h1 class='charname'><input
          name='name'
          type='text'
          value='{{item.name}}'
          placeholder='Name'
        /></h1>
    </div>
  </header>
    <div class="grid grid-2col align-center">
      <div class="align-center">Spell School:<select name="system.school">{{selectOptions item.system.schools selected=item.system.school}}</select><br><br>Tier: <select name="system.tier">{{selectOptions item.system.tiers selected=item.system.tier}}</select></div>
      <div class="align-center">Lists<br><div class="grid grid-2col" style="margin: 0px; row-gap:0px">
        <p style="margin: 0px;">Arcane: <input type="checkbox" name="system.lists.arcane" {{checked item.system.lists.arcane}}></p>
        <p style="margin: 0px;">Divine: <input type="checkbox" name="system.lists.divine" {{checked item.system.lists.divine}}></p>
        <p style="margin: 0px;">Occult: <input type="checkbox" name="system.lists.occult" {{checked item.system.lists.occult}}></p>
        <p style="margin: 0px;">Primal: <input type="checkbox" name="system.lists.primal" {{checked item.system.lists.primal}}></p></div></div>
    </div>
    <div class="align-center">
    Prepped: <select name="system.prepared" style="width: 85%;">{{selectOptions item.system.prep_options selected=item.system.prepared}}</select>
    </div>

  {{! Sheet Tab Navigation }}
  <nav class='sheet-tabs tabs' data-group='primary'>
    <a class='item' data-tab='description'>Description</a>
    <a class='item' data-tab='action'>Action Config</a>
    <a class='item' data-tab='effect'>Effect Config</a>
  </nav>

  {{! Sheet Body }}
  <section class='sheet-body'>

    {{! Description Tab }}
    <div class='tab' data-group='primary' data-tab='description'>
      <div class="grid grid-2col" style="min-height: 100%; height:fit-content">
      {{! Editors must receive enriched text data from getData to properly handle rolls }}
      <ul style="list-style: none;">
          <li>Traits: <a class="new-trait"><i class='fas fa-plus'></i>New Trait</a></li>
          <li><select name="system.t_main">{{selectOptions item.system.trait_list2 selected=item.system.t_main}}</select></li>
          {{#each item.system.trait as |i key|}}<li><input style="width:90%" type="text" name="system.trait.{{key}}" value="{{i}}"><a class="remove-trait" data-key="{{key}}"><i class='fas fa-trash'></i></a></li>{{/each}}
          <li>Verbal: <input type="checkbox" name="system.components.v" {{checked item.system.components.v}}></li>
          <li>Somatic: <input type="checkbox" name="system.components.s" {{checked item.system.components.s}}></li>
          <li>Material: <input type="checkbox" name="system.components.m" {{checked item.system.components.m}}></li>
          <li><input type="text" name="system.components.material", value="{{system.components.material}}"></li>
          <li>Focus: <input type="checkbox" name="system.components.f" {{checked item.system.components.f}}></li>
          <li>Concentration: <input type="checkbox" name="system.components.c" {{checked item.system.components.c}}></li>
        </ul>
        <div>
      {{editor
        enrichedDescription
        target='system.description'
        engine='prosemirror'
        button=true
        editable=editable
      }}</div>
    </div></div>
    <div class="tab action" data-group="primary" data-tab="action">
      {{> 'systems/mandm/templates/item/parts/item-action-config.hbs'}}
    </div>
    <div class='tab' data-group='primary' data-tab='effect'>
      {{> "systems/mandm/templates/item/parts/item-effects.hbs"}}
    </div>
      {{! As you add new fields, add them in here! }}
    </div>
  </section>
</form>